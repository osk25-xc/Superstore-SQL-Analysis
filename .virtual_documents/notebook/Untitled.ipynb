import pandas as pd
import numpy as np
import sqlite3
import matplotlib.pyplot as plt
import seaborn as sns

from pathlib import Path


BASE_DIR = Path("..")

DATA_DIR = BASE_DIR / "data"
SQL_DIR = BASE_DIR / "sql"
VISUALS_DIR = BASE_DIR / "visuals"

DATA_DIR.mkdir(exist_ok=True)
SQL_DIR.mkdir(exist_ok=True)
VISUALS_DIR.mkdir(exist_ok=True)

print("Project folders ready!")


np.random.seed(42)

n = 3000

products = [
    "Laptop",
    "Smartphone",
    "Monitor",
    "Keyboard",
    "Mouse",
    "Printer",
    "Tablet",
    "Headphones",
    "Office Chair",
    "Desk"
]

categories = {
    "Laptop": "Technology",
    "Smartphone": "Technology",
    "Monitor": "Technology",
    "Keyboard": "Technology",
    "Mouse": "Technology",
    "Printer": "Office Supplies",
    "Tablet": "Technology",
    "Headphones": "Technology",
    "Office Chair": "Furniture",
    "Desk": "Furniture"
}

regions = [
    "North",
    "South",
    "East",
    "West",
    "Central"
]

segments = [
    "Consumer",
    "Corporate",
    "Home Office"
]

customers = [
    f"CUST{1000+i}"
    for i in range(500)
]

dates = pd.date_range(
    start="2025-01-01",
    end="2025-12-31",
    periods=n
)

product = np.random.choice(
    products,
    n
)

price_map = {
    "Laptop": 65000,
    "Smartphone": 30000,
    "Monitor": 15000,
    "Keyboard": 2000,
    "Mouse": 1000,
    "Printer": 12000,
    "Tablet": 25000,
    "Headphones": 3000,
    "Office Chair": 9000,
    "Desk": 12000
}

quantity = np.random.randint(
    1,
    6,
    n
)

unit_price = np.array([
    price_map[p] * np.random.uniform(0.85, 1.15)
    for p in product
])

discount = np.random.uniform(
    0,
    0.25,
    n
)

sales = (
    quantity *
    unit_price *
    (1 - discount)
)

profit_margin = np.random.uniform(
    0.08,
    0.30,
    n
)

profit = sales * profit_margin

df = pd.DataFrame({

    "Order_ID": [
        f"ORD{10000+i}"
        for i in range(n)
    ],

    "Order_Date": dates,

    "Customer_ID": np.random.choice(
        customers,
        n
    ),

    "Product": product,

    "Category": [
        categories[p]
        for p in product
    ],

    "Region": np.random.choice(
        regions,
        n
    ),

    "Segment": np.random.choice(
        segments,
        n
    ),

    "Quantity": quantity,

    "Unit_Price": unit_price.round(2),

    "Discount": discount.round(2),

    "Sales": sales.round(2),

    "Profit": profit.round(2)
})

df.head()


csv_path = DATA_DIR / "superstore_sales.csv"

df.to_csv(
    csv_path,
    index=False
)

print("Dataset saved:", csv_path)


db_path = DATA_DIR / "superstore.db"

connection = sqlite3.connect(
    db_path
)

df.to_sql(
    "sales",
    connection,
    if_exists="replace",
    index=False
)

print("SQLite database created successfully!")



